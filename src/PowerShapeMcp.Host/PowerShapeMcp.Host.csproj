<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.45.0-dev</Version>
  </PropertyGroup>
  <ItemGroup><InternalsVisibleTo Include="NativeFixtureCheck" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="[2.2.0]" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="[10.0.12]" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Schemas/prepared-tools.json" LogicalName="prepared-tools.json" />
    <EmbeddedResource Include="Schemas/execution-tools.json" LogicalName="execution-tools.json" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../RotationSampleVerifier.cs" Link="RotationSampleVerifier.cs" />
    <Compile Include="../UniformScaleSampleVerifier.cs" Link="UniformScaleSampleVerifier.cs" />
    <Compile Include="../DmtMeshReader.cs" Link="DmtMeshReader.cs" />
    <Compile Include="../DgkBundleVerifier.cs" Link="DgkBundleVerifier.cs" />
    <Compile Include="../WorkplaneFrame.cs" Link="WorkplaneFrame.cs" />
  </ItemGroup>
</Project>
